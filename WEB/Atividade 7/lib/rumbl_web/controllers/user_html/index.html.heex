<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Listing Users</h1>
  <.link navigate={~p"/users/new"} class="font-semibold text-indigo-600 hover:underline">
    + New User
  </.link>
</div>

<table class="mt-4 w-full text-left">
  <thead>
    <tr class="border-b">
      <th class="py-2">User</th>
      <th class="py-2">Actions</th>
    </tr>
  </thead>
  <tbody>
    <%= for user <- @users do %>
      <tr class="border-b">
        <td class="py-2"><.user user={user} /></td>
        <td class="py-2 flex gap-3">
          <.link navigate={~p"/users/#{user.id}"} class="text-indigo-600 hover:underline">View</.link>
          <.link navigate={~p"/users/#{user.id}/edit"} class="text-amber-600 hover:underline">Edit</.link>
          <.link
            href={~p"/users/#{user.id}"}
            method="delete"
            data-confirm="Are you sure?"
            class="text-red-600 hover:underline"
          >Delete</.link>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
