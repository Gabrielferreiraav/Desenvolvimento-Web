<h1 class="text-2xl font-bold">New User</h1>

<%= if @changeset.action do %>
  <div class="mt-4 rounded bg-red-100 p-4 text-red-700">
    <p>Oops, something went wrong! Please check errors.</p>
  </div>
<% end %>

<.form :let={f} for={@changeset} action={~p"/users"} class="mt-4 space-y-4">
  <div>
    <.input field={f[:name]} type="text" placeholder="Name" />
  </div>
  <div>
    <.input field={f[:username]} type="text" placeholder="Username" />
  </div>
  <div>
    <.button>Create User</.button>
  </div>
</.form>

<p class="mt-4">
  <.link navigate={~p"/users"} class="text-indigo-600 hover:underline">&larr; Back to list</.link>
</p>
